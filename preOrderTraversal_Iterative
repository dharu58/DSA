class Solution {
public:
    vector<int> preorderTraversal(TreeNode* root) {
        vector<int> preOrder;
        if(root == nullptr) return preOrder;

        stack<TreeNode*> st;
        st.push(root);
        while(!st.empty()){
            root = st.top();
            st.pop();
            preOrder.push_back(root -> val);
            if(root -> right != nullptr){
                st.push(root -> right);
            }
            if(root -> left != nullptr){
                st.push(root -> left);
            }
        }
        return preOrder;
    }
};